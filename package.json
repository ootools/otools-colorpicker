{
  "name": "otools-colorpicker",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "description": "A standalone OTools custom-window screen color picker.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5994",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "vue": "3.5.27",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "otools-plugin-sdk": "^0.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12",
    "jsdom": "26.1.0"
  }
}
